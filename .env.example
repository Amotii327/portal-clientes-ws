# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repositorio
# (ya esta en .gitignore). En el VPS los valores van en el gestor de secretos de Coolify.

# URL del proyecto de Supabase (panel de Supabase > Project Settings > API).
# En local con `supabase start`: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Llave publica (anon / publishable). Es segura para el navegador SOLO porque todas las tablas
# tienen RLS. En local la imprime `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direccion publica del portal (para los enlaces de invitacion). Ejemplo: https://portal.websourcing.com.co
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# La llave de sistema (service role) NO se declara aqui. Solo el modulo `notificaciones`
# (sprint 6) la usa, desde el gestor de secretos, y una revision automatica impide usarla en otro lado.

# Soporte: correo de Websourcing que se muestra en los mensajes de acceso suspendido (el dueno lo confirma).
NEXT_PUBLIC_CONTACTO_SOPORTE=

# SOLO DESARROLLO: con `true`, el super admin ve en pantalla el enlace de invitacion (aviso "solo desarrollo")
# porque aun no hay envio de correos (Resend, pendiente). Se ignora si NODE_ENV es production. Dejalo vacio en el VPS.
MOSTRAR_ENLACE_INVITACION_DEV=
